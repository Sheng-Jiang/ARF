# ARF Dashboard — copy to .env and fill in values
# .env is gitignored; never commit real values

DATA_SOURCE=local          # local | gcs
LOCAL_DB_PATH=data/arf.db  # used when DATA_SOURCE=local
GCS_BUCKET=arf-data        # GCS bucket name (DATA_SOURCE=gcs)
GCS_DB_OBJECT=arf.db       # object path within the bucket
GCP_PROJECT=my-project-id  # GCP project ID
